{
  "name": "holy-agents-kits",
  "version": "0.7.0",
  "description": "Agent Skills 合集：Jenkins 流水线、Jenkins 控制器、new-api 应用与 CLI、代码图谱分析、IDEA MCP 代码检视、选择性分支同步、规则层治理、文档内容管理、知识可视化、Skill 开发与校验。一条命令装进你的 agent。",
  "bin": {
    "holy-agents-kits": "bin/cli.js"
  },
  "files": [
    "bin/",
    "skills/",
    "README.md",
    "FEEDBACK.md",
    "LICENSE",
    "!skills/*/config.json"
  ],
  "scripts": {
    "check": "python skills/skill-creator-v2/scripts/validate_skill.py --all --root .",
    "test": "npm run check && node bin/cli.js list",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "agent-skills",
    "skill",
    "jenkins",
    "jenkinsfile",
    "new-api",
    "codegraph",
    "code-analysis",
    "idea-backend",
    "intellij",
    "jetbrains",
    "code-inspection",
    "p3c",
    "git",
    "ci",
    "rules-governance",
    "documentation",
    "knowledge-graph",
    "visualization",
    "claude",
    "trae"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monsterbude123/holy-agents-kits.git"
  },
  "author": "monsterbude123",
  "license": "MIT"
}
