# ==================== generic-storage-sync 本地环境配置模板 ====================
# 将本文件复制到项目根目录下的 .agents/.env 中使用

# 1. 本地缓冲盘路径 (可填绝对路径; 不填则默认使用当前工作目录下的 buffer/)
STORAGE_BUFFER_SPACE="./buffer"

# 2. 目标存储介质端点配置
# 变量名 STORAGE_TARGET_<ID> → 介质 id = <ID> 的小写形式；值格式 <type>:<endpoint>
# type ∈ local|sftp|smb|baidu|quark；相对 endpoint 相对项目根解析
# 本地物理盘 / 移动硬盘 / 局域网挂载路径
STORAGE_TARGET_LOCAL_BACKUP="local:./backup/snapshots"
# 局域网 SMB 挂载 (Windows UNC 或 Linux 挂载点)
# STORAGE_TARGET_NAS="local://192.168.1.100/backup/snapshots"

# 3. 存储生命周期与淘汰保留策略
# 每个仓库在介质上保留的最大完整快照数 (超出部分自动转入回收站，保底必须 ≥ 1)
STORAGE_MAX_RETAINED_SNAPSHOTS=2

# 回收站 .trash/ 冷却存活期 (天数，冷却期满后才允许执行物理清理)
STORAGE_TRASH_TTL_DAYS=7
