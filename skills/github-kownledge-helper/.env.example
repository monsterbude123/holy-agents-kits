# ==================== github-kownledge-helper 本地环境配置模板 ====================
# 将本文件复制到项目根目录下的 .agents/.env 中使用

# 项目根绝对路径（必填）：manifest.json / repos/ / docs/ 的唯一入口
GITHUB_KNOWLEDGE_HELPER_SPACE="D:/path/to/your/project-root"
# 兼容旧拼写（二选一即可）：GITHUB_KOWNLEDGE_HELPER_SPACE
# 可选：doc-map-manager 脚本目录（缺省 ~/.agents/skills/doc-map-manager/scripts）
# DOC_MAP_MANAGER_SCRIPTS=""

# 可选：仓库本体（repos/）的根目录 —— 缺省为 <项目根>/repos。
# 配置后仓库本体统一放到项目根之外（例如放大盘的 GitHub 目录）。
# 必须是已存在的绝对路径；manifest 的 path 字段相对此根目录，不含 repos/ 前缀。
# GITHUB_KNOWLEDGE_HELPER_REPOS_DIR="D:/path/to/GitHub"
