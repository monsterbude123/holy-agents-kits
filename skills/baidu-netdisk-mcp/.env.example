# 复制为 .env 后填写真实值；.env 不入库、不入分发包。
# 优先级：系统环境变量 > <项目根>/.agents/.env > <技能目录>/.env
# 也可写进 skills/baidu-netdisk-mcp/config.json（机器本地，不入库）。
# ZCode 配置文件路径（内含 mcp.servers.baidu-server 的 MCP 启动参数与 AccessToken）
ZCODE_CONFIG=~/.zcode/cli/config.json
# 本地盘点库文件位置（SQLite）
BAIDU_INVENTORY_DB=~/.zcode/cache/baidu-netdisk.db
