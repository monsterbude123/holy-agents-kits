# =========================================
# publish CLI — 环境配置模板
# =========================================
# 复制此文件为 <仓库根>/.agents/.env，按下面注释填写真实值。
# 运行时由 publish/config/store.py 自动加载（ENV_FILE=<仓库根>/.agents/.env）。
# .agents/.env 绝不要提交到 git！
# =========================================

# ── 1. DNS 提供商（必填，三选一） ─────────
# 注意：你选哪个，下面对应提供商的字段才需要填
# dnspod 目前未实现（缺 TC3 签名），只支持 cloudflare / aliyun
DNS_PROVIDER=aliyun

# ── 2A. 阿里云 DNS（如果 DNS_PROVIDER=aliyun） ──
# 获取方式：
#   1. https://ram.console.aliyun.com → 用户 → 创建用户 → 编程访问
#   2. 勾选"Open API 调用访问"，创建后立即复制保存（Secret 仅显示一次）
#   3. 给用户授权策略：AliyunDNSFullAccess
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 你要发布子域名的"主域"，例如发布 app.example.com 就填 example.com
ALIYUN_DOMAIN=

# ── 2B. Cloudflare DNS（如果 DNS_PROVIDER=cloudflare） ──
# 获取方式：
#   1. https://dash.cloudflare.com → My Profile → API Tokens
#   2. Create Token → "Edit zone DNS" 模板 → Zone Resources 选域名
#   3. Zone ID 在域名 Overview 页面右下角 API 段
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── 2C. DNSPod（DNS_PROVIDER=dnspod — 未实现，勿用） ──
# 获取方式：
#   1. https://console.dnspod.cn → 账号中心 → API 密钥管理 → 创建密钥
DNSPOD_SECRET_ID=
DNSPOD_SECRET_KEY=
DNSPOD_DOMAIN=

# ── 3. SSH 连接到云机器（必填） ─────────
# 你的云机器公网 IP 或域名
SSH_HOST=

# SSH 用户名（通常是 root 或 ubuntu）
SSH_USER=root

# SSH 端口（默认 22）
SSH_PORT=22

# SSH 认证 — 密钥或密码二选一
# 私钥路径（推荐），例如 ~/.ssh/id_rsa
SSH_KEY_PATH=
# 密码认证（不推荐，密钥更安全）
SSH_PASSWORD=

# ── 4. 部署时常用参数（可选） ───────────
# 是否默认申请 SSL 证书（deploy --ssl/--no-ssl）
DEFAULT_ENABLE_SSL=true

# 每次 deploy 最多保留的备份版本数（VR-007 默认 5）
MAX_BACKUPS=5
